<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Same rationale as UAssetEditor.Core.Tests' own NoWarn - these all fight xUnit
         convention or test-project shape rather than catching a real defect here. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1861;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAssetEditor.App\UAssetEditor.App.csproj" />
  </ItemGroup>

</Project>
