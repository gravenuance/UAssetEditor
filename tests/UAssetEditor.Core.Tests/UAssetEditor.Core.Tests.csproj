<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Analyzer rules that fight xUnit convention or test-project shape rather than catching
         real defects here:
         CA1707 (underscores in identifiers) is how this suite's own Arrange_Act_Assert-style
         test names read best; CA1711 flags PakTestCollection for ending in "Collection", which
         is xUnit's own required naming pattern for a [CollectionDefinition]; CA1861 (hoist a
         literal array to a static field) targets hot-path allocation, not a one-shot array
         built once per Assert.Equal call in a test that runs once; CA2007 (ConfigureAwait)
         doesn't matter in test methods xUnit itself drives; CA1515 (consider making public
         types internal) doesn't fit a test assembly - nothing external references this DLL,
         and xUnit needs public test classes/methods to discover them via reflection anyway. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1861;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UAssetEditor.Core\UAssetEditor.Core.csproj" />
    <!-- Not used directly by test code - referenced only so `dotnet test` always builds the
         worker executable PakWorkerProcess's dev fallback path discovery expects to find
         alongside this project's own output. See PakWorkerProcess.TryFindDevBuildOutput. -->
    <ProjectReference Include="..\..\src\UAssetEditor.PakWorker\UAssetEditor.PakWorker.csproj" />
  </ItemGroup>

</Project>
