<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UAssetEditor.Core\UAssetEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="UAssetEditor.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>UAssetEditor.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>UAssetEditor</Product>
    <Description>A focused editor for Unreal Engine .uasset data - browse, search, batch-edit, and repack, without opening the engine.</Description>

    <!-- CA2007 ("consider ConfigureAwait") is wrong advice throughout this WPF project's own
         code: ViewModel/View async methods deliberately keep the default ConfigureAwait(true)
         so their continuations resume on the UI dispatcher thread, where they touch bound
         ObservableCollections/properties directly - ConfigureAwait(false) here would risk a
         cross-thread access exception, not just be a style nit. (UAssetEditor.Core, which has
         no UI thread to return to, keeps CA2007 enabled and fixed.)
         CA1515 ("consider making public types internal") doesn't fit an EXE: nothing outside
         this assembly ever references UAssetEditor.App.dll as a library, so every ViewModel/
         View being public is already exactly as encapsulated as it needs to be.
         CA1848 (use LoggerMessage source-gen delegates) targets hot-path logging - every log
         call in this app fires on startup/shutdown or inside a user-facing error handler, none
         of them frequent enough for the extra delegate-caching boilerplate to earn its keep.
         CA1873 (argument evaluation may be unnecessary if logging is disabled) is the same
         non-hot-path reasoning: these calls aren't frequent enough for a guarded IsEnabled
         check to matter. -->
    <NoWarn>$(NoWarn);CA2007;CA1515;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!--
    UAssetEditor.Core's own conditional DebugType=embedded (see its .csproj) doesn't
    reliably take effect for this project when it's built as a ProjectReference during a
    single-file publish - MSBuild's PublishSingleFile flows far enough to bundle Core's DLL
    into the .exe, but not consistently far enough for its DebugType to follow, so
    Core's .pdb can still land next to the .exe as a stray file even though App's own pdb
    is correctly embedded. Deleting it after Publish is a direct fix for that specific
    symptom rather than fighting MSBuild's project-reference property propagation further.
  -->
  <Target Name="RemoveStrayReferencedPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_StrayPdb Include="$(PublishDir)*.pdb" Exclude="$(PublishDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(_StrayPdb)" />
  </Target>

  <!--
    Publishes UAssetEditor.PakWorker (a separate process that hosts every call into the
    native repak_bind.dll, so a crash there can't take this app down with it - see
    UAssetEditor.Core/AssetSources/PakWorker/) and embeds the resulting single .exe as a
    resource in THIS assembly, so the app stays a single downloadable file even though a
    real companion process exists at runtime. PakWorkerProcess (Core) extracts this resource
    to LocalAppData on first use and launches it from there.

    Runs as an out-of-process `dotnet publish` (Exec), not an in-process <MSBuild> task call,
    specifically to avoid this project's own global properties (TargetFramework=
    net10.0-windows, RuntimeIdentifier, PublishDir, ...) bleeding into the worker's build,
    which targets plain net10.0 and has its own PublishDir - an in-process MSBuild task call
    inherits ambient global properties in ways that are easy to get subtly wrong across a
    TargetFramework/RID boundary like this one.

    BeforeTargets="BeforeCompile" (not just "Publish"): EmbeddedResource items must be known
    before CoreCompile embeds resources into the assembly, and BeforeCompile is the
    documented SDK extensibility point that runs early enough for that.
  -->
  <PropertyGroup>
    <_PakWorkerProject>$(MSBuildThisFileDirectory)..\UAssetEditor.PakWorker\UAssetEditor.PakWorker.csproj</_PakWorkerProject>
    <_PakWorkerPublishExe>$(MSBuildThisFileDirectory)..\UAssetEditor.PakWorker\bin\Release\net10.0\publish\win-x64\UAssetEditor.PakWorker.exe</_PakWorkerPublishExe>
  </PropertyGroup>

  <!--
    Split into two independent halves on purpose:
    1. A target that just makes the worker .exe exist on disk (a side effect - ordering only
       needs to land before CoreCompile actually reads the file's bytes, so BeforeTargets=
       CoreCompile is enough here).
    2. A plain top-level EmbeddedResource item (below), evaluated once at project-load time
       like any other item in this file - it does NOT need the referenced file to exist yet
       at evaluation time, only by the time csc actually embeds it, which target #1 already
       guarantees. Originally tried building both the file *and* wiring the item from inside
       one target (BeforeTargets="BeforeCompile", later "AssignTargetPath") - neither
       reliably got a dynamically-added EmbeddedResource item to actually reach csc.exe's
       /resource: arguments, confirmed by grepping the compiler invocation. Splitting the
       "produce the file" step from the "declare the item" step sidesteps that fragility
       entirely instead of chasing the exact right hook name.
  -->
  <Target Name="PublishPakWorker" BeforeTargets="CoreCompile" Condition="'$(PublishSingleFile)' == 'true'">
    <Exec Command="dotnet publish &quot;$(_PakWorkerProject)&quot; -p:PublishProfile=SingleFileRelease -v:q" />
    <Error Condition="!Exists('$(_PakWorkerPublishExe)')" Text="PakWorker publish did not produce the expected exe at $(_PakWorkerPublishExe)" />
  </Target>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\UAssetEditor.PakWorker\bin\Release\net10.0\publish\win-x64\UAssetEditor.PakWorker.exe">
      <LogicalName>UAssetEditor.PakWorker.exe</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    retoc.exe (converts between Unreal's IoStore/Zen container format and legacy .pak - see
    UAssetEditor.Core/AssetSources/IoStore/RetocProcess.cs) is a vendored third-party binary,
    not built from this repo's own source, so unlike PakWorker.exe above there's no publish
    step to produce it first - just embed the file that's already checked in at vendor/.
    Still scoped to PublishSingleFile only (not every plain `dotnet build`), so a normal dev
    loop doesn't pay to embed a ~7MB binary into the assembly on every build; RetocProcess's
    own dev fallback (EmbeddedToolLocator.FindUnderSrcSibling) finds this same vendored file
    directly by path outside of a single-file publish. See THIRD_PARTY_NOTICES.md.
  -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)vendor\retoc.exe">
      <LogicalName>retoc.exe</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

</Project>
