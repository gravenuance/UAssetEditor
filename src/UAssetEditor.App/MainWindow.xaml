<Window x:Class="UAssetEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UAssetEditor.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="UAssetEditor" Height="900" Width="1400" MinWidth="1000" MinHeight="650"
        Background="{StaticResource Mono.Background}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <!-- Extends the themed client-area background up into the native title-bar strip
         (which WPF otherwise leaves as plain system chrome) while keeping the native
         minimize/maximize/close buttons and system menu working - no hand-drawn chrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <!-- Every layer below sets its own Background explicitly rather than relying on
         transparency + inheritance from the Window - a gap in that chain (e.g. a WrapPanel's
         unused row width) would otherwise show through as unthemed white. -->
    <Grid Background="{StaticResource Mono.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar strip: plain themed background + app name, draggable by WindowChrome's
             CaptionHeight by default since nothing here needs IsHitTestVisibleInChrome -
             except the caption buttons, which are hand-drawn (not left to DWM) since native
             caption glyphs did not reliably render over a WindowChrome background of this
             configuration - this way "the window can always be closed" doesn't depend on it. -->
        <Border Grid.Row="0" Background="{StaticResource Mono.Panel}" BorderBrush="{StaticResource Mono.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="UAssetEditor" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mono.Muted}" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#x2500;" Click="MinimizeButton_Click" Style="{StaticResource Mono.TitleBarButton}" ToolTip="Minimize" />
                    <Button Content="&#x25A1;" Click="MaximizeRestoreButton_Click" Style="{StaticResource Mono.TitleBarButton}" ToolTip="Maximize/Restore" />
                    <Button Content="&#xD7;" Click="CloseButton_Click" Style="{StaticResource Mono.TitleBarButton}" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8" Background="{StaticResource Mono.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Source / versioning / session settings -->
            <GroupBox Header="Asset source" Grid.Row="0" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Source (folder, .pak, or .uasset file):" VerticalAlignment="Center" Margin="4" />
                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Width="360" VerticalAlignment="Center" Margin="4" />
                    <Button x:Name="BrowseSourceButton" Content="Browse..." Click="BrowseSourceButton_Click" Margin="4" Padding="8,2"
                            ToolTip="Pick a folder, .pak file, or .uasset file">
                        <Button.ContextMenu>
                            <!-- A ContextMenu is a separate popup root and doesn't inherit DataContext through
                                 the visual tree like normal children do - rebind it explicitly via the
                                 PlacementTarget (set to this Button in code-behind) so its MenuItem commands
                                 can still reach the MainViewModel. -->
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Folder..." Command="{Binding BrowseSourceFolderCommand}" />
                                <MenuItem Header="File (.pak/.uasset)..." Command="{Binding BrowseSourceFileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Load" Command="{Binding LoadSourceCommand}" Margin="4" Padding="8,2"
                            ToolTip="Load the source above - folder, .pak, or .uasset is auto-detected" />

                    <TextBlock Text="AES key (hex, optional, for .pak):" VerticalAlignment="Center" Margin="12,4,4,4" />
                    <TextBox Text="{Binding PakAesKeyHex, UpdateSourceTrigger=PropertyChanged}" Width="140" VerticalAlignment="Center" Margin="4" />
                    <Button Content="Repack..." Command="{Binding RepackCommand}" Margin="4" Padding="8,2"
                            Visibility="{Binding IsPakBacked, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Engine version:" VerticalAlignment="Center" Margin="4" />
                    <ComboBox ItemsSource="{Binding EngineVersions}" SelectedItem="{Binding DefaultEngineVersion}" Width="150" Margin="4" />

                    <TextBlock Text="Usmap (optional):" VerticalAlignment="Center" Margin="12,4,4,4" />
                    <TextBox Text="{Binding UsmapPath, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center" Margin="4" />
                    <Button Content="Browse..." Command="{Binding BrowseUsmapCommand}" Margin="4" Padding="8,2" />

                    <CheckBox Content="Back up before saving (alongside the original file)" IsChecked="{Binding CreateBackup}" VerticalAlignment="Center" Margin="16,4,4,4" />

                    <Button Content="Save Config" Command="{Binding SaveConfigCommand}" Margin="16,4,4,4" Padding="8,2" />
                    <Button Content="Load Config" Command="{Binding LoadConfigCommand}" Margin="4" Padding="8,2" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="4" Padding="8,2" Style="{StaticResource Mono.AccentButton}" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Search / edit scope: one condition list per dimension, AND/OR per list -->
        <GroupBox Header="Search / edit scope (one condition per line)" Grid.Row="1" Margin="0,0,0,8" Padding="8">
            <UniformGrid Columns="4" Rows="1">
                <StackPanel Margin="4">
                    <TextBlock Text="Export (entry) name contains:" />
                    <TextBox Text="{Binding ExportNameConditionsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Height="70" />
                    <ComboBox ItemsSource="{Binding MatchLogics}" SelectedItem="{Binding ExportNameLogic}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Property name contains:" />
                    <TextBox Text="{Binding PropertyNameConditionsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Height="70" />
                    <ComboBox ItemsSource="{Binding MatchLogics}" SelectedItem="{Binding PropertyNameLogic}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Value contains:" />
                    <TextBox Text="{Binding ValueConditionsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Height="70" />
                    <ComboBox ItemsSource="{Binding MatchLogics}" SelectedItem="{Binding ValueLogic}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Reference contains:" />
                    <TextBox Text="{Binding ReferenceConditionsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Height="70" />
                    <ComboBox ItemsSource="{Binding MatchLogics}" SelectedItem="{Binding ReferenceLogic}" Margin="0,4,0,0" />
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <!-- Tree / results / rules / preview -->
        <Grid Grid.Row="2" Background="{StaticResource Mono.Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Browse" Grid.Column="0" Padding="6" ToolTip="Check exports/assets and click Load Selected, or double-click one export to open it alone">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Load Selected" Command="{Binding LoadSelectedCommand}"
                            HorizontalAlignment="Left" Margin="0,0,0,4" Padding="8,2" />
                    <TreeView x:Name="AssetTree" Grid.Row="1" ItemsSource="{Binding RootTreeItems}"
                              MouseDoubleClick="AssetTree_MouseDoubleClick" TreeViewItem.Expanded="AssetTree_Expanded">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                              Visibility="{Binding IsCheckable, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Background="{StaticResource Mono.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,4" Background="{StaticResource Mono.Background}">
                    <Button Content="Search" Command="{Binding SearchCommand}" Margin="0,0,4,0" Padding="12,2" />
                    <Button Content="Save All Edited" Command="{Binding SaveAllEditedCommand}" Margin="4,0" Padding="12,2" />
                    <Button Content="Close Workspace" Command="{Binding CloseWorkspaceCommand}" Margin="4,0" Padding="8,2" />
                    <Button Content="Promote Selected to Rule"
                            Command="{Binding PromoteToRuleCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}"
                            Margin="4,0" Padding="8,2" />
                </WrapPanel>

                <GroupBox Header="Search results (Value is directly editable, in place, across any number of rows/assets)" Grid.Row="1" Padding="6"
                          ToolTip="Edited rows are highlighted until you click Save All Edited, which writes every edit to disk at once.">
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" IsEnabled="{Binding IsIdle}">
                        <DataGrid.RowStyle>
                            <!-- No visible "dirty" indicator/column - just a quiet highlight on rows with an
                                 edit not yet written to disk, so nothing needs explaining to use the grid. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Mono.DirtyHighlight}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Export" Binding="{Binding ExportName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Property" Binding="{Binding PropertyPath}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*">
                                <DataGridTextColumn.CellStyle>
                                    <!-- Reference and Unsupported rows have nowhere to write an edit to - disabling
                                         the cell (rather than leaving it editable and silently doing nothing) makes
                                         that visible instead of inviting an edit that will never take effect. -->
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Property">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4" Background="{StaticResource Mono.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Batch edit rules (applied to every asset in the loaded source matching the scope above)" Grid.Row="0" Margin="0,0,0,8" Padding="8">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="4" Width="150">
                                <ComboBox ItemsSource="{Binding RuleKindOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedRuleKind}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding SelectedRuleKindDescription}" TextWrapping="Wrap" FontStyle="Italic"
                                           Foreground="{StaticResource Mono.Muted}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox Text="{Binding RuleValue1, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="4" ToolTip="Value / pattern / tag / old reference / numeric target" />
                            <TextBox Text="{Binding RuleValue2, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="4" ToolTip="Replacement / new reference" />
                            <ComboBox ItemsSource="{Binding NumericOperations}" SelectedItem="{Binding RuleOperation}" Width="70" Margin="4" ToolTip="Numeric Adjust operation" />
                            <CheckBox Content="Regex" IsChecked="{Binding RuleIsRegex}" VerticalAlignment="Center" Margin="4" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="Skip if current value" IsChecked="{Binding RuleUseSkip}" VerticalAlignment="Center" Margin="4" />
                            <ComboBox ItemsSource="{Binding SkipComparisons}" SelectedItem="{Binding RuleSkipComparison}" Width="70" Margin="4" />
                            <TextBox Text="{Binding RuleSkipValue, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="4" ToolTip="Skip comparison value" />
                            <Button Content="Add rule" Command="{Binding AddRuleCommand}" Margin="12,4,4,4" Padding="8,2" />
                        </WrapPanel>
                        <ListBox x:Name="RulesListBox" ItemsSource="{Binding Rules}" Height="100" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button Content="Remove" DockPanel.Dock="Right" Padding="6,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="4" Padding="12,2" />
                            <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="4" Padding="12,2" Style="{StaticResource Mono.AccentButton}" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Preview (old -&gt; new)" Grid.Row="1" Padding="6">
                    <DataGrid ItemsSource="{Binding PreviewChanges}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset" Binding="{Binding AssetPath}" Width="2*" />
                            <DataGridTextColumn Header="Property" Binding="{Binding PropertyPath}" Width="*" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleDescription}" Width="*" />
                            <DataGridTextColumn Header="Old" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="4,8,4,4">
            <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCompleted}"
                         Width="300" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>
        </Grid>
    </Grid>
</Window>
