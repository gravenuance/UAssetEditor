<Project>
  <!--
    Packages the app as one self-contained .exe for distribution - no separately-installed
    .NET runtime and no companion DLLs alongside it required on the target machine (the
    native repak_bind.dll and WPF's own native interop DLLs are bundled in and resolved
    from inside the single file at runtime; IncludeAllContentForSelfExtract is what makes
    that work for WPF specifically: DirectWriteForwarder.dll and its siblings are mixed-mode
    C++/CLI assemblies, which the in-memory bundle cannot load - without the property the
    app dies at startup with a BadImageFormatException. The SDK flags the property as legacy
    (NETSDK1244) and offers no alternative for those assemblies, hence the suppression.
    Scoped to this publish profile only, via `dotnet
    publish -p:PublishProfile=SingleFileRelease` (or Visual Studio's Publish menu) - a
    plain `dotnet build`/`dotnet run`/`dotnet publish` is entirely unaffected, so the normal
    Debug/Release dev loop stays exactly as fast and framework-dependent as before.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1244</MSBuildWarningsAsMessages>
    <DebugType>embedded</DebugType>
    <PublishDir>bin\Release\net11.0-windows\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
