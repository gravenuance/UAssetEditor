<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hosts every direct call into UAssetAPI's embedded native `repak_bind.dll` (pak open/
    read/write) in a separate process, so a native crash in that library (confirmed:
    STATUS_STACK_BUFFER_OVERRUN on a specific real-world pak entry) kills only this worker,
    not the whole app. See UAssetEditor.Core/AssetSources/PakWorker/ for the shared
    protocol/framing code and the App-side client that spawns and talks to this process.
    No UI dependency - deliberately plain net10.0, not net10.0-windows.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UAssetEditor.Core\UAssetEditor.Core.csproj" />
  </ItemGroup>

  <!--
    Oodle is the COMPRESS_Custom codec of legacy UE4 paks (ECompressionFlags 0x04) - Days
    Gone's 30GB pak is entirely None-or-Oodle, so without this library those paks can be
    listed but not read. repak_bind loads it by name from beside whichever executable hosts
    it, and pak reads happen in THIS process, so it has to land next to the worker rather
    than next to the app or CLI. See THIRD_PARTY_NOTICES.md.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\UAssetEditor.App\vendor\oo2core_9_win64.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\UAssetEditor.App\vendor\oo2core_9_win64.dll')">
      <Link>oo2core_9_win64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Same stray-pdb fix as UAssetEditor.App.csproj: Core's own conditional
       DebugType=embedded doesn't reliably follow it through a ProjectReference during a
       single-file publish. -->
  <Target Name="RemoveStrayReferencedPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_StrayPdb Include="$(PublishDir)*.pdb" Exclude="$(PublishDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(_StrayPdb)" />
  </Target>

</Project>
