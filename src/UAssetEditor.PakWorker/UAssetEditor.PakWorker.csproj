<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hosts every direct call into UAssetAPI's embedded native `repak_bind.dll` (pak open/
    read/write) in a separate process, so a native crash in that library (confirmed:
    STATUS_STACK_BUFFER_OVERRUN on a specific real-world pak entry) kills only this worker,
    not the whole app. See UAssetEditor.Core/AssetSources/PakWorker/ for the shared
    protocol/framing code and the App-side client that spawns and talks to this process.
    No UI dependency - deliberately plain net11.0, not net11.0-windows.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Published single-file for win-x64 (SingleFileRelease). The lock file needs that runtime, and the
         single-file analyzer on in every build so restore always sees the ILLink pack it pulls in. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UAssetEditor.Core\UAssetEditor.Core.csproj" />
  </ItemGroup>

  <!--
    Oodle (the COMPRESS_Custom codec of legacy UE4 paks - Days Gone's 30GB pak is entirely
    None-or-Oodle) is proprietary and is not shipped: the host finds the user's own
    oo2core_*_win64.dll (OodleLibrary) and sends its path with each OpenReader request. A copy
    next to this exe would be dropped by the single-file bundle (NETSDK1236) anyway.
    See THIRD_PARTY_NOTICES.md.
  -->

  <!-- Same stray-pdb fix as UAssetEditor.App.csproj: Core's own conditional
       DebugType=embedded doesn't reliably follow it through a ProjectReference during a
       single-file publish. -->
  <Target Name="RemoveStrayReferencedPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_StrayPdb Include="$(PublishDir)*.pdb" Exclude="$(PublishDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(_StrayPdb)" />
  </Target>

</Project>
