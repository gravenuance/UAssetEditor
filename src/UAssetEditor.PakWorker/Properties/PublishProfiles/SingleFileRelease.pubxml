<Project>
  <!--
    Publishes this worker as one self-contained .exe, same shape as
    UAssetEditor.App/Properties/PublishProfiles/SingleFileRelease.pubxml - the App's publish
    embeds this profile's output as a resource and self-extracts it at runtime (see
    UAssetEditor.Core/AssetSources/PakWorker/PakWorkerProcess.cs), so the *shipped* app is
    still one file even though a real OS process boundary exists at runtime.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>bin\Release\net10.0\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
