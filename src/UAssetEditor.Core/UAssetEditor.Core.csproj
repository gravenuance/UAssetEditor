<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Matches UAssetEditor.App's SingleFileRelease publish profile: embed this project's
       own debug symbols too instead of leaving a separate UAssetEditor.Core.pdb next to
       the single .exe. Only takes effect for that specific publish (PublishSingleFile is
       unset for a normal build/run/test), so this project's own Debug/Release output and
       the test project are unaffected. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Vendored from source (not the 1.1.0 NuGet package) - the latest upstream commit at
       vendoring time fixes a real bug where any asset using FInstancedStruct anywhere failed
       to parse at all (fell back to an unparseable RawExport). Not yet in a tagged NuGet
       release. See /THIRD_PARTY_NOTICES.md and /vendor/UAssetAPI-NOTICE.md. -->
  <ItemGroup>
    <ProjectReference Include="../../vendor/UAssetAPI/UAssetAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UAssetEditor.Core.Tests" />
  </ItemGroup>

</Project>
